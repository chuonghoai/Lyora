# ============================================================
# Lyora Backend Local Environment
# Cấu hình môi trường phát triển cục bộ cho Backend NestJS
# ============================================================

PORT=3000
NODE_ENV=dev

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lyora_db

JWT_SECRET=lyora_super_secret_jwt_key_replace_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=lyora_super_secret_refresh_key_replace_in_production_2026
JWT_REFRESH_EXPIRES_IN=30d

# Optional Redis URL (nếu để trống sẽ tự động fallback sang In-Memory Store ở môi trường dev)
# REDIS_URL=redis://localhost:6379

