{
  "name": "lyora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Lyora Monorepo (NestJS Backend + Unified ReactJS Web Portal)",
  "workspaces": [
    "lyora_backend",
    "lyora_web"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=lyora_backend",
    "backend:build": "npm run build --workspace=lyora_backend",
    "backend:test": "npm run test --workspace=lyora_backend",
    "backend:lint": "npm run lint --workspace=lyora_backend",
    "backend:seed": "npm run seed:create --workspace=lyora_backend",
    "backend:db:reset": "npm run seed:reset --workspace=lyora_backend",
    "web:dev": "npm run dev --workspace=lyora_web",
    "web:build": "npm run build --workspace=lyora_web",
    "web:test": "npm run test --workspace=lyora_web",
    "web:lint": "npm run lint --workspace=lyora_web",
    "dev": "concurrently \"npm run backend:dev\" \"npm run web:dev\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "concurrently \"npm run backend:lint\" \"npm run web:lint\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "minimatch": "11.0.8",
    "glob": "14.0.6",
    "multer": "2.5.0"
  }
}
